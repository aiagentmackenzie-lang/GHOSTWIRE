# GHOSTWIRE server configuration. Copy to .env and edit.
# .env is gitignored - never commit real keys.

# REQUIRED if exposing the server beyond loopback (the server refuses to bind
# a non-loopback host without this). Bearer token for /api/analyze + /ws.
GHOSTWIRE_API_KEY=

# Bind host. Default 127.0.0.1 (loopback, safe). Set 0.0.0.0 to expose - requires
# GHOSTWIRE_API_KEY (fail-closed) + a TLS-terminating reverse proxy upstream.
GHOSTWIRE_HOST=127.0.0.1
PORT=3001

# Where captures may be read from (colon-separated). Default: project samples/.
GHOSTWIRE_ALLOWED_DIRS=

# Safety limits.
GHOSTWIRE_MAX_PCAP_BYTES=524288000       # 500 MiB
GHOSTWIRE_ANALYSIS_TIMEOUT_MS=240000     # 240 s
GHOSTWIRE_RATE_MAX=20
GHOSTWIRE_RATE_WINDOW=1 minute

# Override the Python interpreter the server shells out to (default: .venv).
GHOSTWIRE_PYTHON_BIN=

# Data dir (SQLite job store + audit log). Default: ./data
GHOSTWIRE_DATA_DIR=

# C2 IOC feeds dir (Phase 4.2). Default: bundled engine/feeds.
GHOSTWIRE_FEEDS_DIR=

# Built dashboard dir to serve at / (Phase 5). Default: ./dashboard/dist.
GHOSTWIRE_DASHBOARD_DIR=