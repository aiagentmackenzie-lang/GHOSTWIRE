# Dashboard (Vite) env. Copy to .env and edit. Vars are VITE_-prefixed to be
# exposed to the client bundle.

# API base URL. Leave empty when the dashboard is served by the GHOSTWIRE
# server itself (same-origin). For dev (vite dev server on :5173), set this
# to the API server.
VITE_API_BASE=http://localhost:3001

# Optional bearer token if the API server requires GHOSTWIRE_API_KEY.
# WARNING: anything VITE_-prefixed is embedded in the client bundle and visible
# to anyone who loads the dashboard. Only set this for trusted single-user
# on-prem deployments; for multi-user, use a reverse proxy that injects auth.
VITE_API_TOKEN=